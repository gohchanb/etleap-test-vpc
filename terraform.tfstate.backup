    {
      "module": "module.vpc",
      "mode": "managed",
      "type": "aws_ssm_document",
      "name": "portforward_db",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "index_key": 0,
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:ssm:us-east-1:209479308486:document/PortForwardingDB-test2",
            "attachments_source": [],
            "content": "  {\n    \"schemaVersion\": \"1.0\",\n    \"description\": \"Document to start port forwarding session to DB over Session Manager restricted to 3306\",\n    \"sessionType\": \"Port\",\n    \"parameters\": {\n      \"portNumber\": {\n        \"type\": \"String\",\n        \"description\": \"(Optional) Port number of the server on the instance\",\n        \"allowedPattern\": \"^3306$\",\n        \"default\": \"3306\"\n      },\n      \"localPortNumber\": {\n        \"type\": \"String\",\n        \"description\": \"(Optional) Port number on local machine to forward traffic to. An open port is chosen at run-time if not provided\",\n        \"allowedPattern\": \"^([0-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$\",\n        \"default\": \"0\"\n      },\n      \"host\": {\n        \"type\": \"String\",\n        \"description\": \"(Optional) Hostname or IP address of the destination server\",\n        \"allowedPattern\": \"^[^,$^\u0026\\\\(\\\\)!;'\\\"\u003c\u003e\\\\`{}\\\\[\\\\]\\\\|#=]{3,}$\",\n        \"default\": \"localhost\"\n      }\n    },\n    \"properties\": {\n      \"portNumber\": \"{{ portNumber }}\",\n      \"type\": \"LocalPortForwarding\",\n      \"localPortNumber\": \"{{ localPortNumber }}\",\n      \"host\": \"{{ host }}\"\n    }\n  }\n",
            "created_date": "2026-09-04T15:08:07Z",
            "default_version": "1",
            "description": "",
            "document_format": "JSON",
            "document_type": "Session",
            "document_version": "1",
            "hash": "db4d2169def58e4b674850b12929027d1116309fadcdee973779f9f208a30cb7",
            "hash_type": "Sha256",
            "id": "PortForwardingDB-test2",
            "latest_version": "1",
            "name": "PortForwardingDB-test2",
            "owner": "209479308486",
            "parameter": [
              {
                "default_value": "3306",
                "description": "(Optional) Port number of the server on the instance",
                "name": "portNumber",
                "type": "String"
              },
              {
                "default_value": "0",
                "description": "(Optional) Port number on local machine to forward traffic to. An open port is chosen at run-time if not provided",
                "name": "localPortNumber",
                "type": "String"
              },
              {
                "default_value": "localhost",
                "description": "(Optional) Hostname or IP address of the destination server",
                "name": "host",
                "type": "String"
              }
            ],
            "permissions": null,
            "platform_types": [
